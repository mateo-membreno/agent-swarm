{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness.backend",
  "title": "Backend",
  "description": "Where inference runs: a local GPU server, a local CPU server, or a hosted API. Agents never see backends; they use model aliases.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "kind"],
  "x-create-by": "kind",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$",
      "description": "Unique id, e.g. local-gpu. Model aliases point at it."
    },
    "description": { "type": "string", "maxLength": 300 },
    "kind": {
      "enum": ["local_gpu", "local_cpu", "hosted_api"],
      "x-enum-labels": { "local_gpu": "Local GPU (vLLM)", "local_cpu": "Local CPU (llama.cpp)", "hosted_api": "Hosted API" },
      "description": "Local backends run on services_net with no egress. Hosted backends send prompts off the machine."
    },
    "endpoint": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$",
      "x-when": { "kind": ["local_gpu", "local_cpu"] },
      "description": "OpenAI-compatible endpoint of the local server."
    },
    "gpus": {
      "anyOf": [
        { "const": "auto" },
        { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 }
      ],
      "x-when": { "kind": ["local_gpu"] },
      "description": "\"auto\" or a list of device indexes, e.g. [0, 1]."
    },
    "threads": { "type": "integer", "minimum": 1, "maximum": 512, "x-when": { "kind": ["local_cpu"] } },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024,
      "description": "How many requests the gateway sends this backend at once. Others wait in the gateway's queue."
    },
    "provider": { "enum": ["anthropic", "openai_compatible"], "x-when": { "kind": ["hosted_api"] } },
    "base_url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "x-when": { "kind": ["hosted_api"], "provider": ["openai_compatible"] }
    },
    "credential": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "x-when": { "kind": ["hosted_api"] },
      "description": "Name of a vault entry. Never paste the key itself."
    },
    "egress_host": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
      "x-when": { "kind": ["hosted_api"] },
      "description": "Host added to the gateway egress allowlist."
    },
    "daily_spend_cap_usd": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-when": { "kind": ["hosted_api"] },
      "description": "Required for hosted backends so spend is always bounded."
    }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "enum": ["local_gpu", "local_cpu"] } }, "required": ["kind"] }, "then": { "required": ["endpoint"] } },
    { "if": { "properties": { "kind": { "const": "hosted_api" } }, "required": ["kind"] }, "then": { "required": ["provider", "credential", "egress_host", "daily_spend_cap_usd"] } },
    { "if": { "properties": { "provider": { "const": "openai_compatible" } }, "required": ["provider"] }, "then": { "required": ["base_url"] } }
  ]
}
