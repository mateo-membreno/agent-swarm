{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness.api",
  "title": "API",
  "description": "An external endpoint or adapter that agents and connectors may call through the gateway.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "kind", "backend", "args_schema"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,62}$",
      "description": "Unique id, referenced by agents (reads.apis / writes.apis) and connectors."
    },
    "description": { "type": "string", "maxLength": 300 },
    "kind": {
      "enum": ["read", "effect"],
      "description": "read = no side effects (pull API). effect = changes something outside; prefer a sink connector."
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["http", "adapter"], "description": "http = call a URL. adapter = built-in code adapter (e.g. OAuth flows)." },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "x-when": { "type": ["http"] },
          "description": "https only. The host is added to the gateway's egress allowlist."
        },
        "method": {
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"],
          "x-when": { "type": ["http"] }
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "x-when": { "type": ["adapter"] },
          "description": "Name of the code adapter, e.g. gcal_freebusy."
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "http" } }, "required": ["type"] }, "then": { "required": ["url", "method"] } },
        { "if": { "properties": { "type": { "const": "adapter" } }, "required": ["type"] }, "then": { "required": ["name"] } }
      ]
    },
    "credential": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Name of a vault entry. Never paste the secret itself."
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "x-when-sibling": "credential",
      "description": "How the gateway injects the credential for http backends.",
      "properties": {
        "type": { "enum": ["bearer", "header", "query"] },
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$", "x-when": { "type": ["header", "query"] }, "description": "Header or query parameter name." }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["header", "query"] } }, "required": ["type"] }, "then": { "required": ["name"] } }
      ]
    },
    "args_schema": {
      "type": "object",
      "description": "JSON Schema for the arguments an agent may pass. Must set additionalProperties: false."
    },
    "fixed_args": {
      "type": "object",
      "description": "Arguments pinned by the gateway that the agent cannot control."
    },
    "approval": { "enum": ["none", "required"], "default": "none", "description": "required = operator approves each call (effect APIs)." },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rate": { "type": "string", "pattern": "^[1-9][0-9]*/(sec|min|hour|day)$", "description": "e.g. 30/min" },
        "timeout": { "type": "string", "pattern": "^[1-9][0-9]*(s|m)$", "description": "e.g. 10s" },
        "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 }
      }
    }
  }
}
